# Copia este archivo como .env.local y rellena los valores
# cp .env.example .env.local

# ── Supabase ──────────────────────────────────────────────
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica

# ── Login nativo con Google (Android/iOS) ────────────────
# Web Client ID: el mismo que ya tengas en Supabase Dashboard →
# Authentication → Providers → Google (no hace falta crear uno nuevo).
# iOS Client ID: créalo en Google Cloud Console (tipo "iOS", bundle id
# es.villena.fiestas) y añádelo también como "Authorized Client ID" en
# Supabase junto al de Android.
VITE_GOOGLE_WEB_CLIENT_ID=tu-web-client-id.apps.googleusercontent.com
VITE_GOOGLE_IOS_CLIENT_ID=tu-ios-client-id.apps.googleusercontent.com
